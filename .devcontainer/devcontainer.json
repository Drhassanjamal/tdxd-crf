{
  // GitHub Codespaces configuration for the OncoSmart demo (synthetic data only).
  // Creating a codespace installs dependencies, starts PostgreSQL 16, loads the demo
  // data, builds the app and serves it on port 4000 — no terminal commands needed.
  "name": "OncoSmart demo",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": { "label": "OncoSmart", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
