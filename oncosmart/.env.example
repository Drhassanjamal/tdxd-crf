# =============================================================================
# OncoSmart — environment configuration (copy to .env and adjust)
# NEVER commit real secrets. All values below are placeholders / local-dev defaults.
# =============================================================================

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://oncosmart:CHANGE_ME@localhost:5432/oncosmart

# JWT signing secret — REQUIRED in production (generate: openssl rand -hex 48)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Set to true only when the API is served over HTTPS (secure cookies)
COOKIE_SECURE=false

# Demo mode: shows DEMO / TEST DATA banner and demo-login shortcuts.
DEMO_MODE=true
# Password assigned to the seeded demo accounts (demo only!)
SEED_DEMO_PASSWORD=Demo@2026

# Messaging provider: mock | whatsapp_cloud
MESSAGING_PROVIDER=mock
# Mock provider: automatically advance SENT -> DELIVERED -> READ (seconds)
MOCK_WHATSAPP_AUTO_PROGRESS=true

# WhatsApp Business Cloud API (only used when MESSAGING_PROVIDER=whatsapp_cloud)
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=chemo_appointment_reminder

# Notification worker poll interval (ms)
NOTIFICATION_WORKER_INTERVAL_MS=10000
